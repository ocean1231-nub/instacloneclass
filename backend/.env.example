# Supabase: Connect > Direct > Session pooler에서 연결 문자열을 복사합니다.
# [YOUR-PASSWORD]는 DB 비밀번호로 바꿉니다. postgres://와 postgresql:// 모두 지원합니다.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres

# Supabase: 프로젝트 홈의 Project URL에서 복사합니다.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase: Project Settings > API Keys의 secret 키를 복사합니다.
# 이 키는 서버에서만 사용합니다. 브라우저 코드 또는 VITE_ 변수에 넣지 마세요.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
